# Rellix — static-host headers
#
# Netlify and Cloudflare Pages read this file automatically. Other hosts need
# the equivalent configured in their own server block (see README → Hosting).
#
# frame-src is `https:` rather than three provider hosts because the Custom URL
# source accepts any public http(s) origin by design. connect-src has to include
# api.themoviedb.org and image.tmdb.org: this build calls TMDB directly from the
# browser, because there is no server to call it for us.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https:; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.themoviedb.org https://image.tmdb.org; worker-src 'self'; manifest-src 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Immutable build assets. A redeploy changes the hash in the filename.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must never be cached, or an update can be pinned for a day.
/sw.js
  Cache-Control: no-cache
